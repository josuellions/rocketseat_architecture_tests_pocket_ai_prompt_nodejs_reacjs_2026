{
  "name": "prompt-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run services:up && next dev",
    "start": "next start",
    "build": "prisma generate && prisma migrate deploy &&  next build",
    "services:prisma:seed": "prisma db seed",
    "services:prisma:create": "prisma generate",
    "services:prisma:migrate": "prisma migrate dev",
    "services:up": "docker compose -f infra/docker-compose.yml up -d",
    "services:stop": "docker compose -f infra/docker-compose.yml stop",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "lint:type:check": "tsc --noEmit --skipLibCheck",
    "lint:prettier:format": "prettier --write",
    "lint:eslint:check": "eslint",
    "test": "jest",
    "test:check": "pnpm exec tsc --noEmit --skipLibCheck",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "test:coverage": "jest --coverage",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:e2e:headed": "pnpm exec playwright test --headed",
    "test:e2e:debug": "pnpm exec playwright test --debug",
    "test:e2e:report": "pnpm exec playwright show-report"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.76.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lefthook": "^2.1.8",
    "prettier": "^3.8.3",
    "prisma": "7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
